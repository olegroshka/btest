# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtualenvs
.venv/

# Node
frontend/node_modules/
frontend/.vite/

# Local caches / outputs
local_cache/
local_cache.bak/
outputs/
**/outputs/

# Research — lives in workspace-root research/ folder, not in btest
research/

# Research generated data — rebuilt from DB, never commit
research/**/shared_data/
research/**/data/*.parquet
tearsheet.html

# Trained model weights (binary, large — rebuilt via training)
*.h5

# Root-level generated data
data/**/*.parquet

# Scratch / one-off debug artifacts
dashboard_lines_1_260.txt

# Local scratch / probe files
_tmp_*.txt
_tmp_*.py
_probe_*.txt
_probe_*.py
*_out.txt
*_out*.txt
ui_clickthrough_results.json
pytest_*_out*.txt

# More scratch artifacts created during debugging
.tmp_*
_meta_query_selection_sync_diagnostics_last.txt

# IDE — machine-specific, not for collaborators
.vscode/

# IDE (may include absolute machine paths)
.idea/
.idea/workspace.xml

# Local UI runtime artifacts
.platform_ui/

# Python packaging artifacts (generated during local builds)
src/quantdsl_backtest.egg-info/

# Dependency lockfiles (project uses uv.lock already unless you intentionally want it)
frontend/package-lock.json
uv.lock

# OS
.DS_Store
Thumbs.db

# Credentials / secrets — never commit these
.env
*.env
secrets.toml

# SMIM OHLCV data (large binary, not committed)
equities/smim/

# SMIM acquired data (large binaries — gitignored, not committed)
# The universe CSVs under data/smim/universes/ ARE committed (small, version-controlled)
data/smim/raw/
data/smim/processed/
data/smim/pit_store/

# EODHD UK/EU acquired data (local vendor data / private cache)
data/raw/eodhd/

# SMIM temporary / scratch files
tmp_*.txt
tmp_*.py

# Built UI assets (generated by frontend build)
src/quantdsl_backtest/platform_ui/assets_dist/assets/*.css
src/quantdsl_backtest/platform_ui/assets_dist/assets/*.map

# Local test runner logs
.test_logs/

# Claude Code local settings (machine-specific, contains permissions)
.claude/settings.local.json

# Agent-generated research data (large parquets, rebuild locally)
research/generated/**/data/
